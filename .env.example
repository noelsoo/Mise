NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Not used by the app today (account deletion runs through an RLS-checked RPC); keep for scripts.
SUPABASE_SECRET_KEY=
# Optional: FoodData Central API key for foods not in the local seed.
FDC_API_KEY=
# Optional: Open Food Facts asks for an identifying User-Agent, e.g. "Mise/1.0 (you@example.com)".
OFF_USER_AGENT=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: recipes spoken in TikTok/Instagram videos. Server only.
# Supadata transcript API key (https://supadata.ai) and an Anthropic key to turn the transcript into a recipe.
SUPADATA_API_KEY=
ANTHROPIC_API_KEY=
